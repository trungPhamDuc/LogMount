@page "/RequestLog/DataByDate"
@model RequestLogDataByDateModel
@{ ViewData["Title"] = "RequestLog theo ngày"; }
<div class="logmount-page">
<div class="page-header mb-4"><h1 class="h2 mb-1">Xem RequestLog theo ngày</h1><p class="text-muted mb-0">Hiển thị nguyên từng dòng như Excel, không gộp dữ liệu.</p></div>
@if(Model.AvailableDates.Count==0){<div class="alert alert-warning">Chưa có dữ liệu RequestLog.</div>}else{
<div class="card shadow-sm mb-4"><div class="card-body"><form method="get" class="row g-3 align-items-end"><div class="col-md-3"><label asp-for="SelectedDate" class="form-label">DATE</label><select asp-for="SelectedDate" class="form-select">@foreach(var date in Model.AvailableDates){<option value="@date">@date</option>}</select></div><div class="col-md-2"><label asp-for="Line" class="form-label">LINE</label><select asp-for="Line" class="form-select"><option value="">Tất cả</option>@foreach(var line in Model.AvailableLines){<option value="@line">@line</option>}</select></div><div class="col-md-2"><label asp-for="PartNo" class="form-label">P/N</label><input asp-for="PartNo" class="form-control" /></div><div class="col-md-2"><label asp-for="TopN" class="form-label">Top</label><select asp-for="TopN" class="form-select"><option value="0">Tất cả</option><option value="10">10</option><option value="20">20</option><option value="30">30</option></select></div><div class="col-md-2"><label asp-for="SortBy" class="form-label">Ưu tiên</label><select asp-for="SortBy" class="form-select"><option value="rqty">Số rơi</option><option value="rate">Tỷ lệ rơi</option><option value="amount">Tổng tiền</option></select></div><div class="col-md-1"><button class="btn btn-primary w-100">Lọc</button></div></form></div></div>
<div class="card shadow-sm mb-4"><div class="card-body"><h2 class="h5">Top linh kiện ngày @Model.SelectedDate</h2><div style="height:400px"><canvas id="requestDailyChart"></canvas></div></div></div>
<div class="card shadow-sm"><div class="card-body"><h2 class="h5">Dữ liệu chi tiết — @Model.Entries.Count dòng</h2><div class="table-responsive"><table class="table table-sm table-striped table-hover"><thead class="table-dark"><tr><th>DATE</th><th>LINE</th><th>P/N</th><th class="text-end">P.Qty</th><th class="text-end">R.Q'ty</th><th class="text-end">Tỷ lệ rơi</th><th class="text-end">Giá 1 con</th><th class="text-end">Tổng tiền</th></tr></thead><tbody>@foreach(var item in Model.Entries){<tr><td>@item.Date</td><td>@item.Line</td><td>@item.PartNo</td><td class="text-end">@item.PQty.ToString("N0")</td><td class="text-end">@item.RQty.ToString("N0")</td><td class="text-end">@(item.PQty==0?"0.00":(item.RQty/item.PQty*100m).ToString("N2"))%</td><td class="text-end">@item.AmtOnRequest.ToString("N0")</td><td class="text-end">@RequestLogDataByDateModel.TotalAmount(item).ToString("N0")</td></tr>}</tbody></table></div></div></div>}</div>
@section Scripts {<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script><script>var data=@Html.Raw(Model.ChartDataJson);if(data.length){new Chart(document.getElementById('requestDailyChart'),{data:{labels:data.map(x=>x.label),datasets:[{type:'bar',label:"Số lượng rơi",data:data.map(x=>x.requestQty),yAxisID:'qty',backgroundColor:'#4d80e8',order:2},{type:'line',label:'Tỷ lệ rơi (%)',data:data.map(x=>x.dropRate),yAxisID:'rate',borderColor:'red',backgroundColor:'red',pointBackgroundColor:'red',pointBorderColor:'white',pointBorderWidth:1,pointRadius:5,pointHoverRadius:7,borderWidth:3,order:0,clip:false}]},options:{responsive:true,maintainAspectRatio:false,scales:{qty:{beginAtZero:true},rate:{position:'right',beginAtZero:true,grid:{drawOnChartArea:false},ticks:{callback:v=>v+'%'}}}}});}</script>}
