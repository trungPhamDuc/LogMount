@model IReadOnlyList<LogMount.Pages.RequestLogSummary>
@{
    var totalRows = ViewData["TotalRows"] is int count ? count : 0;
}

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 card-title mb-0">Tổng hợp theo DATE, LINE, P/N và giá</h2>
            <span class="text-muted small">@totalRows.ToString("N0") dòng nguồn</span>
        </div>

        @if (Model.Count == 0)
        {
            <div class="alert alert-warning mb-0">Không có dữ liệu phù hợp.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>DATE</th>
                            <th>CHASSIS</th>
                            <th>BOARD</th>
                            <th>P/N</th>
                            <th>LINE</th>
                            <th class="text-end">P.Qty (Slg SX)</th>
                            <th class="text-end">R.Q'ty (Slg YC)</th>
                            <th class="text-end">Tỷ lệ rơi</th>
                            <th class="text-end">Giá 1 con (VND)</th>
                            <th class="text-end">Tổng tiền (VND)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var targetMonth = item.Date.Length >= 7 ? item.Date[..7] : null;
                            <tr>
                                <td>@item.Date</td>
                                <td>@item.Chassis</td>
                                <td>@item.Board</td>
                                <td class="fw-semibold">
                                    <a asp-page="/RequestLogDataByMonth"
                                       asp-route-SelectedMonth="@targetMonth"
                                       asp-route-PartNo="@item.PartNo"
                                       asp-route-TopN="0"
                                       class="link-primary text-decoration-none">
                                        @item.PartNo
                                    </a>
                                </td>
                                <td>@item.Line</td>
                                <td class="text-end">@item.PQty.ToString("N0")</td>
                                <td class="text-end">@item.RQty.ToString("N0")</td>
                                <td class="text-end">@item.DropRate.ToString("N2")%</td>
                                <td class="text-end">@item.Amount.ToString("N0")</td>
                                <td class="text-end fw-semibold">@item.TotalAmount.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-secondary fw-semibold">
                            <td colspan="5">Tổng cộng</td>
                            <td class="text-end">@Model.Sum(x => x.PQty).ToString("N0")</td>
                            <td class="text-end">@Model.Sum(x => x.RQty).ToString("N0")</td>
                            <td></td>
                            <td></td>
                            <td class="text-end">@Model.Sum(x => x.TotalAmount).ToString("N0")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>
