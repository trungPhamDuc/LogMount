<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LogMount</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LogMount.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
        var isDashboardPage = currentPage.Equals("/Dashboard", StringComparison.OrdinalIgnoreCase);
        var isAnalysisPage = currentPage.Equals("/Index", StringComparison.OrdinalIgnoreCase) ||
                             currentPage.Equals("/ExpensiveParts", StringComparison.OrdinalIgnoreCase);
        var isDataByDatePage = currentPage.Equals("/DataByDate", StringComparison.OrdinalIgnoreCase);
        var isDataByMonthPage = currentPage.Equals("/DataByMonth", StringComparison.OrdinalIgnoreCase);
        var isRetryLogPage = isDashboardPage || isAnalysisPage || isDataByDatePage || isDataByMonthPage;
    }

    <div class="app-shell">
        <aside class="app-sidebar">
            <a class="sidebar-brand" asp-area="" asp-page="/Dashboard">LogMount</a>
            <nav class="sidebar-nav" aria-label="Dashboard">
                <details class="sidebar-group" @(isRetryLogPage ? "open" : "")>
                    <summary class="sidebar-link sidebar-group-toggle @(isRetryLogPage ? "active" : "")">
                        <span>
                            <span class="sidebar-link-title">RetryLog</span>
                            <span class="sidebar-link-subtitle">Biểu đồ, phân tích và dữ liệu</span>
                        </span>
                    </summary>
                    <div class="sidebar-subnav">
                        <a class="sidebar-link sidebar-sublink @(isDashboardPage ? "active" : "")" asp-area="" asp-page="/Dashboard">
                            <span class="sidebar-link-title">Xem biểu đồ</span>
                        </a>
                        <a class="sidebar-link sidebar-sublink @(isAnalysisPage ? "active" : "")" asp-area="" asp-page="/Index">
                            <span class="sidebar-link-title">Phân tích retryLog</span>
                        </a>
                        <a class="sidebar-link sidebar-sublink @(isDataByDatePage ? "active" : "")" asp-area="" asp-page="/DataByDate">
                            <span class="sidebar-link-title">Xem dữ liệu theo ngày</span>
                        </a>
                        <a class="sidebar-link sidebar-sublink @(isDataByMonthPage ? "active" : "")" asp-area="" asp-page="/DataByMonth">
                            <span class="sidebar-link-title">Xem dữ liệu theo tháng</span>
                        </a>
                    </div>
                </details>
            </nav>
        </aside>

        <main role="main" class="app-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
