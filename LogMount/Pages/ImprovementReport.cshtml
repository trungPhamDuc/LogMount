@page "/ImprovementReport"
@model ImprovementReportModel
@{
    ViewData["Title"] = "Báo cáo PowerPoint";
}

<div class="logmount-page improvement-powerpoint-report">
    <div class="report-paper">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
            <div>
                <h1 class="report-title">1. Expensive Component Summary</h1>
                <div class="text-muted small">
                    Báo cáo ngày @Model.SelectedDate?.ToString("yyyy/MM/dd") từ dữ liệu RetryLog và danh sách linh kiện đắt tiền đã có trong hệ thống.
                </div>
            </div>
            <form method="get" class="d-flex flex-wrap align-items-end gap-2 report-filter">
                <div>
                    <label asp-for="SelectedDate" class="form-label small mb-1">Ngày</label>
                    <select asp-for="SelectedDate" class="form-select form-select-sm">
                        @foreach (var date in Model.AvailableDates)
                        {
                            <option value="@date.ToString("yyyy-MM-dd")">@date.ToString("yyyy/MM/dd")</option>
                        }
                    </select>
                </div>
                <div>
                    <label asp-for="TopN" class="form-label small mb-1">Top</label>
                    <select asp-for="TopN" class="form-select form-select-sm">
                        <option value="5">Top 5</option>
                        <option value="10">Top 10</option>
                        <option value="20">Top 20</option>
                        <option value="30">Top 30</option>
                    </select>
                </div>
                <div>
                    <label asp-for="SortBy" class="form-label small mb-1">Sắp xếp</label>
                    <select asp-for="SortBy" class="form-select form-select-sm">
                        <option value="count-desc">Số lần: Lớn → Nhỏ</option>
                        <option value="cost-desc">Tổng giá tiền: Lớn → Nhỏ</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-sm btn-primary">Xem</button>
                @if (Model.SummaryItems.Count > 0)
                {
                    <a asp-page="/ImprovementReport"
                       asp-page-handler="PowerPoint"
                       asp-route-SelectedDate='@Model.SelectedDate?.ToString("yyyy-MM-dd")'
                       asp-route-TopN="@Model.TopN"
                       asp-route-SortBy="@Model.SortBy"
                       class="btn btn-sm btn-success">Tải PowerPoint</a>
                }
            </form>
        </div>

        @if (Model.AvailableDates.Count == 0)
        {
            <div class="alert alert-warning">Chưa có dữ liệu RetryLog để lập báo cáo.</div>
        }
        else if (Model.SummaryItems.Count == 0)
        {
            <div class="alert alert-warning">Không có linh kiện đắt tiền phát sinh trong ngày đã chọn.</div>
        }
        else
        {
            <div class="row g-4 align-items-start mb-4">
                <div class="col-lg-5">
                    <div class="report-chart-box">
                        <canvas id="expensiveSummaryChart" aria-label="Top linh kiện đắt tiền"></canvas>
                    </div>
                    <div class="report-total mt-3">
                        Tổng cộng ngày @Model.SelectedDate?.ToString("yyyy/MM/dd"):
                        <strong>@Model.TotalCost.ToString("N0") đồng</strong>,
                        <strong>@Model.TotalCount.ToString("N0")</strong> lần
                    </div>
                </div>
                <div class="col-lg-7">
                    <div class="report-notes">
                        <p>- Những Line phải tiến hành cải thiện : @FormatLines(Model.NeedImproveLines)</p>
                        <p>- Những Line đã có báo cáo cải thiện : @FormatLines(Model.ImprovedLines)</p>
                    </div>
                </div>
            </div>

            @foreach (var group in Model.ReportGroups)
            {
                <section class="report-table-section">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h2>Tổng hợp linh kiện đắt tiền</h2>
                        <div class="d-flex gap-2">
                            <span class="export-chip">Tải CSV</span>
                            <span class="export-chip">Tải Excel</span>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm report-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Parts Name</th>
                                    <th>Line</th>
                                    <th>Lane</th>
                                    <th>Mặt</th>
                                    <th>Máy</th>
                                    <th>Feeder</th>
                                    <th>Shift</th>
                                    <th>Error Name</th>
                                    <th class="text-end">Tổng giá tiền</th>
                                    <th class="text-end">Số lần</th>
                                    <th class="text-center">Cải thiện</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in group.Rows)
                                {
                                    var improved = Model.ImprovedLines.Contains(item.Line, StringComparer.OrdinalIgnoreCase);
                                    <tr>
                                        <td class="fw-semibold">@item.PartsName</td>
                                        <td>@item.Line</td>
                                        <td>@item.Lane</td>
                                        <td>@item.SideLabel (@item.Side)</td>
                                        <td>@item.Machine</td>
                                        <td>@item.FeederNo</td>
                                        <td>@item.Shift</td>
                                        <td><span class="@IndexModel.GetErrorNameCssClass(item.ErrorName)">@item.ErrorName</span></td>
                                        <td class="text-end text-danger">@item.TotalCost.ToString("N0") đồng</td>
                                        <td class="text-end">@item.Count.ToString("N0")</td>
                                        <td class="text-center">
                                            <span class="status-pill @(improved ? "done" : "")">@(improved ? "✓" : "□")</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="8">Tổng cộng (đã lọc)</td>
                                    <td class="text-end text-danger">@group.Rows.Sum(x => x.TotalCost).ToString("N0") đồng</td>
                                    <td class="text-end">@group.Rows.Sum(x => x.Count).ToString("N0")</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </section>
            }
        }
    </div>
</div>

@functions {
    private static string FormatLines(IReadOnlyList<string> lines)
    {
        return lines.Count == 0
            ? "chưa có"
            : string.Join(", ", lines.Select(x => x.StartsWith("L", StringComparison.OrdinalIgnoreCase) ? "line " + x[1..] : x));
    }
}

@section Scripts {
    @if (Model.SummaryItems.Count > 0)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
        <script>
            (function () {
                var canvas = document.getElementById('expensiveSummaryChart');
                if (!canvas) return;

                var data = @Html.Raw(Model.ChartDataJson);
                if (!data.length) return;
                var sortBy = '@Model.SortBy';
                var metricKey = sortBy === 'cost-desc' ? 'totalCost' : 'totalCount';
                var metricLabel = sortBy === 'cost-desc' ? 'Tổng giá tiền' : 'Số lần';

                new Chart(canvas, {
                    type: 'bar',
                    data: {
                        labels: data.map(function (x) { return x.partsName; }),
                        datasets: [{
                            label: metricLabel,
                            data: data.map(function (x) { return x[metricKey]; }),
                            backgroundColor: 'rgba(226, 88, 105, 0.86)',
                            borderColor: '#df5b69',
                            borderWidth: 1,
                            borderRadius: 3
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (context) {
                                        var value = Number(context.parsed.x || 0);
                                        return metricLabel + ': ' + value.toLocaleString('vi-VN') + (metricKey === 'totalCost' ? ' đồng' : '');
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                beginAtZero: true,
                                ticks: {
                                    precision: 0,
                                    font: { size: 10 },
                                    callback: function (value) { return Number(value).toLocaleString('vi-VN'); }
                                }
                            },
                            y: { ticks: { autoSkip: false, font: { size: 8 } } }
                        }
                    }
                });
            })();
        </script>
    }
}
