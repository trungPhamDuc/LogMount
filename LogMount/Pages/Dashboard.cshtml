@page
@model DashboardModel
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="logmount-page dashboard-page">
    <div class="page-header mb-4">
        <h1 class="h2 mb-1">Trang chủ</h1>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label asp-for="SelectedDate" class="form-label">Ngày hiển thị</label>
                    <input name="SelectedDate" type="date" class="form-control" value="@Model.SelectedDate?.Replace("/", "-")" />
                </div>
                <div class="col-md-4">
                    <label asp-for="SelectedMonth" class="form-label">Tháng hiển thị</label>
                    <input name="SelectedMonth" type="month" class="form-control" value="@Model.SelectedMonth?.Replace("/", "-")" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">Cập nhật biểu đồ</button>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-6">
            <div class="card shadow-sm h-100 dashboard-chart-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <h2 class="h5 card-title mb-1">Tổng hợp lỗi ngày</h2>
                            <div class="text-muted small">@Model.SelectedDate</div>
                        </div>
                        <span class="dashboard-total-badge">@Model.DailyErrorTotal.ToString("N0") lỗi</span>
                    </div>
                    <div class="dashboard-chart-grid">
                        <div class="dashboard-doughnut-wrapper">
                        <canvas id="dailyErrorChart"></canvas>
                        </div>
                        <div class="dashboard-bar-wrapper">
                            <canvas id="dailyErrorBarChart"></canvas>
                        </div>
                    </div>
                    <div class="dashboard-summary-table-wrapper mt-3">
                        <table class="table table-sm table-striped align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Nội dung</th>
                                    <th class="text-end">Số lỗi</th>
                                    <th class="text-end">Tỷ lệ</th>
                                </tr>
                            </thead>
                            <tbody id="dailyErrorTable"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card shadow-sm h-100 dashboard-chart-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <h2 class="h5 card-title mb-1">Lỗi linh kiện đắt tiền ngày</h2>
                            <div class="text-muted small">@Model.SelectedDate</div>
                        </div>
                        <span class="dashboard-total-badge">@Model.DailyExpensivePartErrorTotal.ToString("N0") lỗi</span>
                    </div>
                    <div class="dashboard-chart-grid">
                        <div class="dashboard-doughnut-wrapper">
                        <canvas id="expensivePartDayChart"></canvas>
                        </div>
                        <div class="dashboard-bar-wrapper">
                            <canvas id="expensivePartDayBarChart"></canvas>
                        </div>
                    </div>
                    <div class="dashboard-summary-table-wrapper mt-3">
                        <table class="table table-sm table-striped align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Parts Name</th>
                                    <th class="text-end">Số lỗi</th>
                                    <th class="text-end">Tỷ lệ</th>
                                </tr>
                            </thead>
                            <tbody id="expensivePartDayTable"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card shadow-sm h-100 dashboard-chart-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <h2 class="h5 card-title mb-1">Tổng hợp lỗi tháng</h2>
                            <div class="text-muted small">@Model.SelectedMonth</div>
                        </div>
                        <span class="dashboard-total-badge">@Model.MonthlyErrorTotal.ToString("N0") lỗi</span>
                    </div>
                    <div class="dashboard-chart-grid">
                        <div class="dashboard-doughnut-wrapper">
                        <canvas id="monthlyErrorChart"></canvas>
                        </div>
                        <div class="dashboard-bar-wrapper">
                            <canvas id="monthlyErrorBarChart"></canvas>
                        </div>
                    </div>
                    <div class="dashboard-summary-table-wrapper mt-3">
                        <table class="table table-sm table-striped align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Nội dung</th>
                                    <th class="text-end">Số lỗi</th>
                                    <th class="text-end">Tỷ lệ</th>
                                </tr>
                            </thead>
                            <tbody id="monthlyErrorTable"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card shadow-sm h-100 dashboard-chart-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <h2 class="h5 card-title mb-1">Lỗi linh kiện đắt tiền tháng</h2>
                            <div class="text-muted small">@Model.SelectedMonth</div>
                        </div>
                        <span class="dashboard-total-badge">@Model.MonthlyExpensivePartErrorTotal.ToString("N0") lỗi</span>
                    </div>
                    <div class="dashboard-chart-grid">
                        <div class="dashboard-doughnut-wrapper">
                        <canvas id="expensivePartMonthChart"></canvas>
                        </div>
                        <div class="dashboard-bar-wrapper">
                            <canvas id="expensivePartMonthBarChart"></canvas>
                        </div>
                    </div>
                    <div class="dashboard-summary-table-wrapper mt-3">
                        <table class="table table-sm table-striped align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Parts Name</th>
                                    <th class="text-end">Số lỗi</th>
                                    <th class="text-end">Tỷ lệ</th>
                                </tr>
                            </thead>
                            <tbody id="expensivePartMonthTable"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            var dashboardPalette = [
                '#dc2626', '#2563eb', '#22c55e', '#f59e0b', '#8b5cf6',
                '#06b6d4', '#ec4899', '#84cc16', '#f97316', '#64748b'
            ];

            var centerTextPlugin = {
                id: 'centerText',
                afterDraw: function (chart) {
                    if (!chart.options.plugins.centerText) {
                        return;
                    }

                    var total = chart.options.plugins.centerText.total || 0;
                    if (total <= 0) {
                        return;
                    }

                    var ctx = chart.ctx;
                    var area = chart.chartArea;
                    var x = (area.left + area.right) / 2;
                    var y = (area.top + area.bottom) / 2;

                    ctx.save();
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.fillStyle = '#111827';
                    ctx.font = '700 22px sans-serif';
                    ctx.fillText(total.toLocaleString(), x, y - 8);
                    ctx.fillStyle = '#64748b';
                    ctx.font = '600 11px sans-serif';
                    ctx.fillText('lỗi', x, y + 18);
                    ctx.restore();
                }
            };

            Chart.register(centerTextPlugin);

            function getPercent(value, total) {
                return total ? (value * 100 / total).toFixed(1) : '0.0';
            }

            function escapeHtml(value) {
                return String(value)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            function getLabel(item) {
                return item.label || '(Không có tên)';
            }

            function buildUrl(baseUrl, parameters) {
                var url = new URL(baseUrl, window.location.origin);
                Object.keys(parameters).forEach(function (key) {
                    var value = parameters[key];
                    if (value !== null && value !== undefined && value !== '') {
                        url.searchParams.set(key, value);
                    }
                });
                return url.pathname + url.search;
            }

            function renderDoughnut(canvasId, data) {
                var canvas = document.getElementById(canvasId);
                if (!canvas) {
                    return;
                }

                if (!data.length) {
                    canvas.parentElement.innerHTML = '<div class="alert alert-warning mb-0">Không có dữ liệu phù hợp.</div>';
                    return;
                }

                var total = data.reduce(function (sum, item) { return sum + item.value; }, 0);
                var colors = data.map(function (_, index) {
                    return dashboardPalette[index] || dashboardPalette[dashboardPalette.length - 1];
                });

                new Chart(canvas, {
                    type: 'doughnut',
                    data: {
                        labels: data.map(getLabel),
                        datasets: [{
                            data: data.map(function (item) { return item.value; }),
                            backgroundColor: colors,
                            borderColor: '#fff',
                            borderWidth: 2,
                            hoverOffset: 8
                        }]
                    },
                    options: {
                        cutout: '62%',
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            centerText: {
                                total: total
                            },
                            legend: {
                                display: false
                            },
                            tooltip: {
                                callbacks: {
                                    label: function (context) {
                                        var value = context.parsed || 0;
                                        var percent = getPercent(value, total);
                                        return (context.label || '(Không có tên)') + ': ' + value.toLocaleString() + ' lỗi (' + percent + '%)';
                                    }
                                }
                            }
                        }
                    }
                });
            }

            function renderBarChart(canvasId, data) {
                var canvas = document.getElementById(canvasId);
                if (!canvas || !data.length) {
                    return;
                }

                new Chart(canvas, {
                    type: 'bar',
                    data: {
                        labels: data.map(getLabel),
                        datasets: [{
                            data: data.map(function (item) { return item.value; }),
                            backgroundColor: 'rgba(220, 38, 38, 0.72)',
                            borderColor: 'rgba(220, 38, 38, 1)',
                            borderWidth: 1,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            x: {
                                beginAtZero: true,
                                ticks: { precision: 0 }
                            },
                            y: {
                                ticks: {
                                    font: { size: 10 }
                                }
                            }
                        }
                    }
                });
            }

            function renderSummaryTable(tableBodyId, data, linkBuilder) {
                var tableBody = document.getElementById(tableBodyId);
                if (!tableBody) {
                    return;
                }

                if (!data.length) {
                    tableBody.innerHTML = '<tr><td colspan="3" class="text-muted text-center">Không có dữ liệu phù hợp.</td></tr>';
                    return;
                }

                var total = data.reduce(function (sum, item) { return sum + item.value; }, 0);
                tableBody.innerHTML = data.map(function (item) {
                    var percent = getPercent(item.value, total);
                    var labelText = item.label || '(Không có tên)';
                    var label = escapeHtml(labelText);
                    var href = linkBuilder ? linkBuilder(labelText) : null;
                    var labelHtml = href
                        ? '<a class="dashboard-table-link" href="' + escapeHtml(href) + '">' + label + '</a>'
                        : label;

                    return '<tr>' +
                        '<td class="text-truncate" title="' + label + '">' + labelHtml + '</td>' +
                        '<td class="text-end fw-semibold">' + item.value.toLocaleString() + '</td>' +
                        '<td class="text-end text-danger fw-semibold">' + percent + '%</td>' +
                    '</tr>';
                }).join('');
            }

            function renderDashboardBlock(doughnutId, barId, tableId, data, linkBuilder) {
                renderDoughnut(doughnutId, data);
                renderBarChart(barId, data);
                renderSummaryTable(tableId, data, linkBuilder);
            }

            var dayDataUrl = '@Url.Page("/DataByDate")';
            var monthDataUrl = '@Url.Page("/DataByMonth")';

            function buildDayErrorUrl(errorName) {
                return buildUrl(dayDataUrl, {
                    SelectedDate: '@Model.SelectedDate',
                    ShowExpensiveParts: 'true',
                    'PartFilter.ErrorName': errorName
                });
            }

            function buildMonthErrorUrl(errorName) {
                return buildUrl(monthDataUrl, {
                    SelectedMonth: '@Model.SelectedMonth',
                    ShowExpensiveParts: 'true',
                    'PartFilter.ErrorName': errorName
                });
            }

            function buildDayPartUrl(partsName) {
                return buildUrl(dayDataUrl, {
                    SelectedDate: '@Model.SelectedDate',
                    ShowExpensiveParts: 'true',
                    'PartFilter.PartsName': partsName
                });
            }

            function buildMonthPartUrl(partsName) {
                return buildUrl(monthDataUrl, {
                    SelectedMonth: '@Model.SelectedMonth',
                    ShowExpensiveParts: 'true',
                    'PartFilter.PartsName': partsName
                });
            }

            renderDashboardBlock('dailyErrorChart', 'dailyErrorBarChart', 'dailyErrorTable', @Html.Raw(Model.DailyErrorChartJson), buildDayErrorUrl);
            renderDashboardBlock('expensivePartDayChart', 'expensivePartDayBarChart', 'expensivePartDayTable', @Html.Raw(Model.ExpensivePartDayChartJson), buildDayPartUrl);
            renderDashboardBlock('monthlyErrorChart', 'monthlyErrorBarChart', 'monthlyErrorTable', @Html.Raw(Model.MonthlyErrorChartJson), buildMonthErrorUrl);
            renderDashboardBlock('expensivePartMonthChart', 'expensivePartMonthBarChart', 'expensivePartMonthTable', @Html.Raw(Model.ExpensivePartMonthChartJson), buildMonthPartUrl);

            function getNextDashboardReloadTime(now) {
                var next = new Date(now);
                next.setMinutes(3, 0, 0);

                if (next.getHours() % 2 !== 0) {
                    next.setHours(next.getHours() + 1);
                }

                if (next <= now) {
                    next.setHours(next.getHours() + 2);
                }

                return next;
            }

            var nextReloadTime = getNextDashboardReloadTime(new Date());
            window.setTimeout(function () {
                window.location.reload();
            }, nextReloadTime.getTime() - Date.now());
        })();
    </script>
}
