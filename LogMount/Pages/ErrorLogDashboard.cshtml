@page "/ErrorLogDashboard"
@model ErrorLogDashboardModel
@{
    ViewData["Title"] = "Biểu đồ ErrorLog";
}

<div class="logmount-page dashboard-page">
    <div class="page-header mb-4">
        <h1 class="h2 mb-1">Biểu đồ ErrorLog</h1>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label asp-for="SelectedDate" class="form-label">Ngày hiển thị</label>
                    <input name="SelectedDate" type="date" class="form-control" value="@Model.SelectedDate?.Replace("/", "-")" />
                </div>
                <div class="col-md-4">
                    <label asp-for="SelectedMonth" class="form-label">Tháng hiển thị</label>
                    <input name="SelectedMonth" type="month" class="form-control" value="@Model.SelectedMonth?.Replace("/", "-")" />
                </div>
                <div class="col-md-2">
                    <label asp-for="TopN" class="form-label">Hiển thị</label>
                    <select asp-for="TopN" class="form-select">
                        @foreach (var option in Model.TopNChoices)
                        {
                            <option value="@option">@(option == 0 ? "Tất cả" : $"Top {option}")</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-6">
            <div class="card shadow-sm h-100 dashboard-chart-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <h2 class="h5 card-title mb-1">Tổng hợp ErrorLog ngày</h2>
                            <div class="text-muted small">@Model.SelectedDate</div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" title="Tải biểu đồ tròn (PNG)" onclick="downloadChartAsImage('dailyErrorLogChart', 'Tong_Hop_ErrorLog_Ngay_Tron.png')">
                                    <i class="bi bi-pie-chart-fill"></i> Tròn
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" title="Tải biểu đồ cột (PNG)" onclick="downloadChartAsImage('dailyErrorLogBarChart', 'Tong_Hop_ErrorLog_Ngay_Cot.png')">
                                    <i class="bi bi-bar-chart-fill"></i> Cột
                                </button>
                            </div>
                            <span class="dashboard-total-badge">@Model.DailyErrorTotal.ToString("N0") lỗi</span>
                        </div>
                    </div>
                    <div class="dashboard-chart-grid">
                        <div class="dashboard-doughnut-wrapper">
                            <canvas id="dailyErrorLogChart"></canvas>
                        </div>
                        <div class="dashboard-bar-wrapper">
                            <canvas id="dailyErrorLogBarChart"></canvas>
                        </div>
                    </div>
                    <div class="dashboard-summary-table-wrapper mt-3">
                        <table class="table table-sm table-striped align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Error</th>
                                    <th class="text-end">Số lần</th>
                                    <th class="text-end">Tỷ lệ</th>
                                </tr>
                            </thead>
                            <tbody id="dailyErrorLogTable"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card shadow-sm h-100 dashboard-chart-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <h2 class="h5 card-title mb-1">Tổng hợp ErrorLog tháng</h2>
                            <div class="text-muted small">@Model.SelectedMonth</div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" title="Tải biểu đồ tròn (PNG)" onclick="downloadChartAsImage('monthlyErrorLogChart', 'Tong_Hop_ErrorLog_Thang_Tron.png')">
                                    <i class="bi bi-pie-chart-fill"></i> Tròn
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" title="Tải biểu đồ cột (PNG)" onclick="downloadChartAsImage('monthlyErrorLogBarChart', 'Tong_Hop_ErrorLog_Thang_Cot.png')">
                                    <i class="bi bi-bar-chart-fill"></i> Cột
                                </button>
                            </div>
                            <span class="dashboard-total-badge">@Model.MonthlyErrorTotal.ToString("N0") lỗi</span>
                        </div>
                    </div>
                    <div class="dashboard-chart-grid">
                        <div class="dashboard-doughnut-wrapper">
                            <canvas id="monthlyErrorLogChart"></canvas>
                        </div>
                        <div class="dashboard-bar-wrapper">
                            <canvas id="monthlyErrorLogBarChart"></canvas>
                        </div>
                    </div>
                    <div class="dashboard-summary-table-wrapper mt-3">
                        <table class="table table-sm table-striped align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Error</th>
                                    <th class="text-end">Số lần</th>
                                    <th class="text-end">Tỷ lệ</th>
                                </tr>
                            </thead>
                            <tbody id="monthlyErrorLogTable"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            var palette = ['#dc2626', '#2563eb', '#22c55e', '#f59e0b', '#8b5cf6', '#06b6d4', '#ec4899', '#84cc16', '#f97316', '#64748b'];

            function getPercent(value, total) {
                return total ? (value * 100 / total).toFixed(1) : '0.0';
            }

            function formatValue(value) {
                return Number(value).toLocaleString(undefined, { maximumFractionDigits: 0 });
            }

            function escapeHtml(value) {
                return String(value)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            function getLabel(item) {
                return item.label || '(Không có lỗi)';
            }

            function buildUrl(baseUrl, parameters) {
                var url = new URL(baseUrl, window.location.origin);
                Object.keys(parameters).forEach(function (key) {
                    var value = parameters[key];
                    if (value !== null && value !== undefined && value !== '') {
                        url.searchParams.set(key, value);
                    }
                });
                return url.pathname + url.search;
            }

            var centerTextPlugin = {
                id: 'centerText',
                afterDraw: function (chart) {
                    if (chart.config.type !== 'doughnut') {
                        return;
                    }
                    var options = chart.options.plugins.centerText || {};
                    var total = options.total || 0;
                    var unit = options.unit || 'lỗi';
                    var ctx = chart.ctx;
                    var area = chart.chartArea;
                    var x = (area.left + area.right) / 2;
                    var y = (area.top + area.bottom) / 2;

                    ctx.save();
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.fillStyle = '#111827';
                    ctx.font = '700 22px sans-serif';
                    ctx.fillText(formatValue(total), x, y - 8);
                    ctx.fillStyle = '#64748b';
                    ctx.font = '600 11px sans-serif';
                    ctx.fillText(unit, x, y + 18);
                    ctx.restore();
                }
            };
            Chart.register(centerTextPlugin);

            function getErrorCssClass(errorName) {
                if (!errorName) return 'error-name-tag error-name-empty';
                var upper = String(errorName).trim().toUpperCase();
                if (upper.indexOf('PICK UP') !== -1 || upper.indexOf('PICKUP') !== -1) return 'error-name-tag error-name-pickup';
                if (upper.indexOf('VACUUM') !== -1 || upper.indexOf('VACCUM') !== -1) return 'error-name-tag error-name-vacuum';
                if (upper.indexOf('AUTORUN') !== -1 || upper.indexOf('AUTO RUN') !== -1) return 'error-name-tag error-name-autorun';
                if (upper.indexOf('PARTS') !== -1) return 'error-name-tag error-name-parts';
                if (upper.indexOf('VISION') !== -1 || upper.indexOf('CAMERA') !== -1 || upper.indexOf('SIDE VIEW') !== -1) return 'error-name-tag error-name-vision';
                if (upper.indexOf('LEAD') !== -1 || upper.indexOf('WIDTH') !== -1) return 'error-name-tag error-name-lead';
                if (upper.indexOf('INTERLOCK') !== -1 || upper.indexOf('NON-SAVED') !== -1 || upper.indexOf('RESET') !== -1) return 'error-name-tag error-name-interlock';
                return 'error-name-tag error-name-default';
            }

            function renderDoughnut(canvasId, data) {
                var canvas = document.getElementById(canvasId);
                if (!canvas) {
                    return;
                }

                if (!data.length) {
                    canvas.parentElement.innerHTML = '<div class="alert alert-warning mb-0">Không có dữ liệu phù hợp.</div>';
                    return;
                }

                var total = data.reduce(function (sum, item) { return sum + item.value; }, 0);
                new Chart(canvas, {
                    type: 'doughnut',
                    data: {
                        labels: data.map(getLabel),
                        datasets: [{
                            data: data.map(function (item) { return item.value; }),
                            backgroundColor: data.map(function (_, index) { return palette[index] || palette[palette.length - 1]; }),
                            borderColor: '#fff',
                            borderWidth: 2,
                            hoverOffset: 8
                        }]
                    },
                    options: {
                        cutout: '62%',
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            centerText: {
                                total: total,
                                unit: 'lỗi'
                            },
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (context) {
                                        var value = context.parsed || 0;
                                        return (context.label || '(Không có lỗi)') + ': ' + formatValue(value) + ' lỗi (' + getPercent(value, total) + '%)';
                                    }
                                }
                            }
                        }
                    }
                });
            }

            function renderBar(canvasId, data) {
                var canvas = document.getElementById(canvasId);
                if (!canvas || !data.length) {
                    return;
                }

                new Chart(canvas, {
                    type: 'bar',
                    data: {
                        labels: data.map(getLabel),
                        datasets: [{
                            data: data.map(function (item) { return item.value; }),
                            backgroundColor: 'rgba(220, 38, 38, 0.72)',
                            borderColor: 'rgba(220, 38, 38, 1)',
                            borderWidth: 1,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { x: { beginAtZero: true, ticks: { precision: 0 } }, y: { ticks: { font: { size: 10 } } } }
                    }
                });
            }

            function renderTable(tableBodyId, data, linkBuilder) {
                var tableBody = document.getElementById(tableBodyId);
                if (!tableBody) {
                    return;
                }

                if (!data.length) {
                    tableBody.innerHTML = '<tr><td colspan="3" class="text-muted text-center">Không có dữ liệu phù hợp.</td></tr>';
                    return;
                }

                var total = data.reduce(function (sum, item) { return sum + item.value; }, 0);
                tableBody.innerHTML = data.map(function (item) {
                    var labelText = getLabel(item);
                    var href = linkBuilder(labelText);
                    var badgeClass = getErrorCssClass(labelText);
                    return '<tr>' +
                        '<td class="text-truncate error-name-cell" title="' + escapeHtml(labelText) + '"><a class="dashboard-table-link" href="' + escapeHtml(href) + '"><span class="' + badgeClass + '">' + escapeHtml(labelText) + '</span></a></td>' +
                        '<td class="text-end fw-semibold">' + formatValue(item.value) + '</td>' +
                        '<td class="text-end text-danger fw-semibold">' + getPercent(item.value, total) + '%</td>' +
                    '</tr>';
                }).join('');
            }

            function renderBlock(doughnutId, barId, tableId, data, linkBuilder) {
                renderDoughnut(doughnutId, data);
                renderBar(barId, data);
                renderTable(tableId, data, linkBuilder);
            }

            var dayDataUrl = '@Url.Page("/ErrorLogDataByDate")';
            var monthDataUrl = '@Url.Page("/ErrorLogDataByMonth")';

            renderBlock('dailyErrorLogChart', 'dailyErrorLogBarChart', 'dailyErrorLogTable', @Html.Raw(Model.DailyErrorChartJson), function (error) {
                return buildUrl(dayDataUrl, { SelectedDate: '@Model.SelectedDate', 'Filter.Error': error });
            });
            renderBlock('monthlyErrorLogChart', 'monthlyErrorLogBarChart', 'monthlyErrorLogTable', @Html.Raw(Model.MonthlyErrorChartJson), function (error) {
                return buildUrl(monthDataUrl, { SelectedMonth: '@Model.SelectedMonth', 'Filter.Error': error });
            });
        })();
    </script>
}
