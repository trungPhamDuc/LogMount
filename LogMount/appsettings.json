{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RetryLogBatch": {
    "BatchFilePath": "E:\\LOG\\RetryLog\\TotalRetryLogDay.bat",
    "OutputFileTemplate": "E:\\LOG\\RetryLog\\TotalRetryLog\\TotalRetryLog{date}.csv",
    "MonthlyOutputFileTemplate": "E:\\LOG\\RetryLog\\TotalRetryLog\\TotalRetryLog{MM}.csv",
